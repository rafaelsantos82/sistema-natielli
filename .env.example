# Frontend (Vite) — copie para .env.local (não versionar secrets)

# Base da API: em dev use /api/v1 (proxy Vite → backend :8080)
VITE_API_BASE_URL=/api/v1

# Pacientes via API Go + PostgreSQL (obrigatório em dev/prod com backend)
# Use false apenas em testes CI sem API
VITE_API_PACIENTES=true
VITE_API_PROFISSIONAIS=true
VITE_API_CONSULTAS=true
VITE_API_SALAS=true
VITE_API_UNIDADES=true
VITE_API_FINANCEIRO=true
VITE_API_TERAPIAS=true
VITE_API_ANAMNESES=true
VITE_API_ESTOQUE=true
VITE_API_RH=true
VITE_API_PLANOS=true
VITE_API_MARKETING=true
VITE_API_PRONTUARIO=true
VITE_API_RELATORIOS=true
VITE_API_CONTABILIDADE=true
VITE_API_COMODATO=true
VITE_API_CONTRATOS=true
VITE_API_AUDIT=true
VITE_API_DOCUMENTOS=true
VITE_API_CHAVE_DIGITAL=true
VITE_API_DOCUMENTOS_ASSINADOS=true

# Login real (email/senha) via POST /auth/login — padrão ligado
VITE_AUTH_LOGIN=true

# true = login dev via POST /auth/token (qualquer senha); use só em E2E legado
VITE_AUTH_BOOTSTRAP=false

# Token bootstrap — NÃO use prefixo VITE_ (não vai para o bundle).
# Defina em .env.local para o proxy do Vite: BOOTSTRAP_AUTH_TOKEN=seu-token-dev
