# Copy to /etc/sistemanatielli/app.env on the droplet (chmod 600). Fill secrets via setup-secrets.sh.

APP_ENV=production
SERVER_PORT=8080

POSTGRES_USER=natielli
POSTGRES_DB=natielli
# Password lives in /etc/sistemanatielli/secrets/pg_password (not in this file)
DATABASE_URL=postgres://natielli@db:5432/natielli?sslmode=disable

JWT_SECRET=
JWT_ISSUER=natielli-api
JWT_EXPIRATION_MINUTES=60

BOOTSTRAP_AUTH_ENABLED=false
BOOTSTRAP_AUTH_TOKEN=

CORS_ALLOWED_ORIGINS=https://sistema.natielli.com.br

SERVICE_NAME=natielli-api
SERVICE_VERSION=v0.0.0
LOG_LEVEL=info
LOG_FORMAT=json
LOG_INCLUDE_CALLER=false
LOG_MASK_IP=true

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_ENABLE_TRACING=true
SENTRY_TRACES_SAMPLE_RATE=0.2

SWAGGER_ENABLED=false

# Uploads de documentos (profissionais) — volume natielli-prod_uploads_data em /data/uploads
UPLOAD_BASE_PATH=/data/uploads
UPLOAD_MAX_BYTES=10485760

# Cifragem de certificados PFX (chave digital por unidade) — obrigatório em produção
SIGNING_MASTER_KEY=

# Password reset (Resend)
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_PUBLIC_URL=https://sistema.natielli.com.br

# Optional login lockout (defaults in backend if omitted)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
