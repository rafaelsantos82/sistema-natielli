# Deploy configuration (no secrets). Sourced by deploy scripts on Mac and droplet.
# Shared VM pstec: Espaço Terapia uses 8080/8081, QR Gestor uses 8082/8083.

DEPLOY_HOST_ALIAS=pstec
DEPLOY_APP_DIR=/opt/sistemanatielli
DEPLOY_ETC_DIR=/etc/sistemanatielli
DEPLOY_DOMAIN=sistema.natielli.com.br
DEPLOY_PUBLIC_URL=https://sistema.natielli.com.br

# Loopback ports on host — MUST NOT use 8080-8083
PROD_API_HOST_PORT=8084
PROD_FRONTEND_HOST_PORT=8085

COMPOSE_PROJECT_NAME=natielli-prod
UPLOADS_VOLUME=natielli-prod_uploads_data

# Droplet capacity: shared VM — always prebuilt
DROPLET_TIER=current
BUILD_STRATEGY=prebuilt

GIT_REPO_URL=git@github.com:rafaelsantos82/sistema-natielli.git
GIT_DEFAULT_BRANCH=main

CERTBOT_EMAIL=admin@ps.tec.br

IMAGE_API=natielli/api
IMAGE_FRONTEND=natielli/frontend
IMAGE_TAG=latest

VITE_API_BASE_URL=https://sistema.natielli.com.br/api/v1

# Neighbor health (must stay up during Natielli deploy)
NEIGHBOR_HEALTH_ESPACOTERAPIA=https://espacoterapia.ps.tec.br/api/v1/health
NEIGHBOR_HEALTH_QRGESTOR=https://qrgestor.com.br/api/v1/health
