APP_ENV=development
SERVER_PORT=8080

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=espaco_terapia
POSTGRES_PORT=5432
# API no Docker Compose usa host "db"; scripts no host (make seed-admin) reescrevem para 127.0.0.1
DATABASE_URL=postgres://postgres:postgres@db:5432/espaco_terapia?sslmode=disable
# Opcional: URL explícita para rodar go/migrate no host
# DATABASE_URL_HOST=postgres://postgres:postgres@127.0.0.1:5432/espaco_terapia?sslmode=disable

# Auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=espaco-terapia-api
JWT_EXPIRATION_MINUTES=60
BOOTSTRAP_AUTH_ENABLED=true
BOOTSTRAP_AUTH_TOKEN=change-bootstrap-token

# Login lockout (por e-mail e IP — complementa rate limit do nginx)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Reset de senha (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@seudominio.com
FRONTEND_PUBLIC_URL=http://localhost:5173

# Primeiro admin (make seed-admin — apenas dev/local)
ADMIN_EMAIL=admin@espacoterapia.local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Administrador

# Comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging (structured slog — see backend/README.md)
SERVICE_NAME=espaco-terapia-api
SERVICE_VERSION=v0.0.0
LOG_LEVEL=
LOG_FORMAT=
LOG_INCLUDE_CALLER=false
LOG_MASK_IP=false

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLE_TRACING=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# Swagger UI em /api/v1/swagger/index.html (recomendado apenas em dev)
SWAGGER_ENABLED=true

# Uploads — host (go run): ./data/uploads | Docker compose: /data/uploads (override no compose)
UPLOAD_BASE_PATH=./data/uploads
UPLOAD_MAX_BYTES=10485760

# Chave digital (PFX por unidade) — AES-GCM em repouso; mín. 32 caracteres em produção
# Gere com: openssl rand -base64 32
SIGNING_MASTER_KEY=dev-only-signing-master-key-32bytes!!
